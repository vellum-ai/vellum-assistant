{
  "version": 1,
  "tools": [
    {
      "name": "desktop_control",
      "description": "Observe or control the streamed assistant desktop. Use scope browser for compact page text, elements and tab actions in its visible Chrome. Browser actions require the latest observation_id and element references; they return structured state without screenshots. Omit scope for screenshot and X11 input. Both scopes share the same guardian conversation control lease. Call done without scope when finished. Never targets a personal browser.",
      "category": "computer-use",
      "risk": "medium",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "observe",
              "click",
              "type",
              "key",
              "scroll",
              "drag",
              "done",
              "navigate",
              "select_tab",
              "new_tab",
              "close_tab",
              "wait"
            ]
          },
          "observation_id": {
            "type": "string",
            "description": "Latest observation_id. Required for input actions."
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "to_x": {
            "type": "integer",
            "minimum": 0
          },
          "to_y": {
            "type": "integer",
            "minimum": 0
          },
          "button": {
            "type": "string",
            "enum": ["left", "right", "middle", "double"]
          },
          "text": {
            "type": "string",
            "maxLength": 10000
          },
          "key": {
            "type": "string",
            "description": "X11 key combination, for example ctrl+l or Return."
          },
          "direction": {
            "type": "string",
            "enum": ["up", "down", "left", "right"]
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "scope": {
            "type": "string",
            "enum": ["browser"]
          },
          "tab_id": {
            "type": "integer",
            "minimum": 1
          },
          "frame_id": {
            "type": "string"
          },
          "element": {
            "type": "string",
            "description": "An element eid from the latest browser observation."
          },
          "url": {
            "type": "string",
            "description": "HTTP or HTTPS URL for browser navigate."
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2000
          }
        },
        "required": ["action"]
      },
      "executor": "tools/desktop-control.ts",
      "execution_target": "sandbox"
    }
  ]
}
