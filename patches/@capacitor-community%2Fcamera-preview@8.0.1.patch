+/** Owns copied preview buffers until a request completes or is cancelled. */
+final class SnapshotPair {
+    static final long TIMEOUT_MS = 5_000;
+    private final long startedAtNanos;
+    private final long spacingNanos;
+    private byte[] first;
+    private long firstAtNanos;
+    private boolean captured;
+    private volatile boolean completed;
+
+    SnapshotPair(int spacingMs, long startedAtNanos) {
+        if (spacingMs < 1 || spacingMs > 120) {
+            throw new IllegalArgumentException("pairSpacingMs must be between 1 and 120");
+        }
+        this.spacingNanos = spacingMs * 1_000_000L;
+        this.startedAtNanos = startedAtNanos;
+    }
+
+    boolean expired(long nowNanos) {
+        return nowNanos - startedAtNanos >= TIMEOUT_MS * 1_000_000L;
+    }
+
+    long remainingMs(long nowNanos) {
+        return Math.max(0, TIMEOUT_MS - (nowNanos - startedAtNanos) / 1_000_000L);
+    }
+
+    Frames capture(byte[] bytes, long nowNanos) {
+        if (completed || captured || expired(nowNanos) || nowNanos < startedAtNanos || bytes == null) {
+            return null;
+        }
+        if (first == null) {
+            first = bytes.clone();
+            firstAtNanos = nowNanos;
+            return null;
+        }
+        if (nowNanos - firstAtNanos < spacingNanos) {
+            return null;
+        }
+        Frames frames = new Frames(
+            first,
+            bytes.clone(),
+            (firstAtNanos - startedAtNanos) / 1_000_000.0,
+            (nowNanos - startedAtNanos) / 1_000_000.0
+        );
+        first = null;
+        captured = true;
+        return frames;
+    }
+
+    boolean complete() {
+        if (completed) {
+            return false;
+        }
+        completed = true;
+        first = null;
+        return true;
+    }
+
+    boolean isCompleted() {
+        return completed;
+    }
+
+    static final class Frames {
+        final byte[] first;
+        final byte[] second;
+        final double firstCapturedAfterMs;
+        final double secondCapturedAfterMs;
+
+        Frames(byte[] first, byte[] second, double firstCapturedAfterMs, double secondCapturedAfterMs) {
+            this.first = first;
+            this.second = second;
+            this.firstCapturedAfterMs = firstCapturedAfterMs;
+            this.secondCapturedAfterMs = secondCapturedAfterMs;
+        }
+    }
+}
