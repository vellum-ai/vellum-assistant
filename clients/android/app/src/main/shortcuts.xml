<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="ai.vellum.assistant.action.OPEN_FEATURE"
            android:targetPackage="__APPLICATION_ID__"
            android:targetClass="ai.vellum.assistant.MainActivity">
            <parameter
                android:name="feature"
                android:key="feature"
                android:required="true" />
        </intent>
    </capability>

    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:shortcutShortLabel="@string/new_chat_shortcut_label"
        android:shortcutLongLabel="@string/new_chat_shortcut_long_label">
        <intent
            android:action="ai.vellum.assistant.action.NEW_CHAT"
            android:targetPackage="__APPLICATION_ID__"
            android:targetClass="ai.vellum.assistant.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="new_chat" />
        </capability-binding>
    </shortcut>

    <shortcut
        android:shortcutId="start_voice"
        android:enabled="true"
        android:icon="@drawable/ic_stat_voice"
        android:shortcutShortLabel="@string/voice_shortcut_label"
        android:shortcutLongLabel="@string/voice_shortcut_long_label">
        <intent
            android:action="ai.vellum.assistant.action.START_VOICE"
            android:targetPackage="__APPLICATION_ID__"
            android:targetClass="ai.vellum.assistant.MainActivity" />
        <capability-binding android:key="actions.intent.OPEN_APP_FEATURE">
            <parameter-binding
                android:key="feature"
                android:value="voice_mode" />
        </capability-binding>
    </shortcut>
</shortcuts>
