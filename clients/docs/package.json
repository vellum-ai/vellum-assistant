{
  "name": "@vellumai/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bun run docs:search:index && bun run generate:agent-markdown",
    "dev": "next dev --port 3005",
    "prebuild": "bun run docs:search:index && bun run generate:agent-markdown",
    "build": "next build",
    "docs:search:index": "bun scripts/generate-docs-search-index.ts",
    "start": "next start",
    "generate:agent-markdown": "bun scripts/generate-agent-markdown.ts",
    "lint": "eslint",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src scripts next-config.test.ts --pass-with-no-tests"
  },
  "dependencies": {
    "@vellumai/design-library": "workspace:*",
    "clsx": "2.1.1",
    "isbot": "5.1.40",
    "lucide-react": "1.16.0",
    "minisearch": "7.2.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.8",
    "@types/bun": "1.3.14",
    "cheerio": "1.2.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.2.0",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-stringify": "11.0.0",
    "tailwindcss": "4.1.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.1",
    "unified": "11.0.5"
  }
